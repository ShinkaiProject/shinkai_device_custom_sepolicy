# Sandbox
allow system_app ax_sandbox_vault_file:dir create_dir_perms;
allow system_app ax_sandbox_vault_file:file create_file_perms;
allow system_app system_data_file:dir r_dir_perms;
allow system_app system_data_file:file r_file_perms;
allow system_app system_userdir_file:dir r_dir_perms;
allow system_app system_userdir_file:file r_file_perms;

# AppLock
allow system_app app_lock_service:service_manager find;
